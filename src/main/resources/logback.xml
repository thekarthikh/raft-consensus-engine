<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%date{HH:mm:ss.SSS} %level %logger{36} - %msg%n</pattern></encoder>
    </appender>
    <logger name="com.raft" level="INFO"/>
    <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
